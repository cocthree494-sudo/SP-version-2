{
  "name": "support-agent",
  "version": "0.0.0",
  "private": true,
  "description": "Multi-tenant customer-support AI SaaS",
  "packageManager": "npm@11.13.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "workspaces": [
    "apps/web",
    "packages/*"
  ],
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:apps": "concurrently --kill-others-on-fail --names api,web,widget --prefix-colors blue,green,magenta \"npm:dev:api\" \"npm:dev:web\" \"npm:dev:widget\"",
    "dev:api": "uv run --project apps/api uvicorn app.main:app --reload --host 127.0.0.1 --port 8000",
    "dev:web": "npm run dev --workspace @support-agent/web",
    "dev:widget": "npm run dev --workspace @support-agent/widget",
    "infra:up": "docker compose --env-file .env -f infra/compose.yaml up -d --wait",
    "infra:down": "docker compose --env-file .env -f infra/compose.yaml down",
    "build": "npm run build --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
