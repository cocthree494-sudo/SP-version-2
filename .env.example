# Application
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
WEB_PORT=3000
WIDGET_PORT=5173
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_WIDGET_LOADER_URL=http://127.0.0.1:5173/loader.js

# Authentication (replace with a random 32+ character value outside local development)
AUTH_JWT_SECRET=local-development-secret-change-before-deployment
AUTH_OTP_SECRET=
# Optional only for isolated APP_ENV=test browser acceptance.
AUTH_OTP_TEST_CODE=
AUTH_OTP_TTL_SECONDS=90
AUTH_OTP_RESEND_COOLDOWN_SECONDS=60
AUTH_OTP_MAX_ATTEMPTS=5
AUTH_OTP_EMAIL_RATE_LIMIT=5
AUTH_OTP_EMAIL_RATE_WINDOW_SECONDS=3600
AUTH_OTP_IP_RATE_LIMIT=20
AUTH_OTP_IP_RATE_WINDOW_SECONDS=3600
AUTH_EMAIL_PROVIDER=memory
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Relay
SMTP_STARTTLS=true
SMTP_TIMEOUT_SECONDS=15
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_DAYS=30

# Social sign-in (leave a provider blank to keep it disabled). Register the
# exact callback URL with each provider; secrets stay server-side only.
OAUTH_WEB_BASE_URL=http://127.0.0.1:3000
OAUTH_STATE_TTL_SECONDS=600
OAUTH_HTTP_TIMEOUT_SECONDS=10
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_MICROSOFT_CLIENT_ID=
OAUTH_MICROSOFT_CLIENT_SECRET=
OAUTH_MICROSOFT_TENANT_ID=common
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=

# PostgreSQL / pgvector
POSTGRES_DB=support_agent
POSTGRES_USER=support_agent
POSTGRES_PASSWORD=support_agent_local
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://support_agent:support_agent_local@127.0.0.1:5432/support_agent
# Security integration tests must connect through this separate, non-owner,
# non-superuser role. Reusing DATABASE_URL silently bypasses PostgreSQL RLS.
TEST_DATABASE_URL=postgresql+asyncpg://support_agent_app:support_agent_app_local@127.0.0.1:5432/support_agent

# Redis
REDIS_PORT=6379
REDIS_URL=redis://127.0.0.1:6379/0

# Development object storage (tenant subdirectories are added automatically)
LOCAL_STORAGE_ROOT=.data/uploads
FILE_UPLOAD_MAX_BYTES=20971520
FILE_UPLOAD_CHUNK_BYTES=65536
FILE_PARSE_MAX_PAGES=1000
FILE_PARSE_MAX_OUTPUT_CHARS=5000000
DOCX_MAX_UNCOMPRESSED_BYTES=104857600
CHUNK_MAX_TOKENS=400
CHUNK_OVERLAP_TOKENS=60
EMBEDDING_BATCH_SIZE=32
EMBEDDING_PROVIDER_ID=deterministic
EMBEDDING_MODEL_ID=deterministic-embedding-v1
EMBEDDING_DIMENSIONS=32
WEBSITE_CRAWL_MAX_PAGES=50
WEBSITE_CRAWL_MAX_DEPTH=3
WEBSITE_CRAWL_REQUEST_DELAY_SECONDS=0.25
WEBSITE_CRAWL_TIMEOUT_SECONDS=15
WEBSITE_CRAWL_MAX_RESPONSE_BYTES=2097152
WEBSITE_CRAWL_MAX_REDIRECTS=5
WEBSITE_CRAWL_USER_AGENT=SupportAgentBot/0.1
RETRIEVAL_CANDIDATE_LIMIT=40
RETRIEVAL_RRF_K=60
RETRIEVAL_VECTOR_WEIGHT=1.0
RETRIEVAL_LEXICAL_WEIGHT=1.0

# AI providers (model IDs and credentials are configuration, never business logic)
AI_PROVIDER_MODE=deterministic
AI_PROVIDER_ID=deterministic
AI_BASE_URL=
AI_API_KEY=
AI_REQUEST_TIMEOUT_SECONDS=30
LLM_MODEL_ID=deterministic-chat-v1
LLM_STRONG_MODEL_ID=deterministic-chat-strong-v1
DETERMINISTIC_LLM_RESPONSE=Deterministic support response.
MODEL_ROUTER_MAX_RETRIES_PER_TARGET=1
MODEL_ROUTER_RETRY_BASE_SECONDS=0.1
MODEL_ROUTER_TOTAL_TIMEOUT_SECONDS=60
MODEL_ROUTER_CIRCUIT_FAILURE_THRESHOLD=3
MODEL_ROUTER_CIRCUIT_COOLDOWN_SECONDS=60
MODEL_ROUTER_WEAK_RETRIEVAL_SCORE=0.012
MODEL_ROUTER_COMPLEXITY_THRESHOLD=0.7
LLM_INPUT_COST_MICROUSD_PER_MILLION=0
LLM_OUTPUT_COST_MICROUSD_PER_MILLION=0
LLM_STRONG_INPUT_COST_MICROUSD_PER_MILLION=0
LLM_STRONG_OUTPUT_COST_MICROUSD_PER_MILLION=0
# Optional tenant BYOK envelope-encryption key. Generate 32 random bytes and
# URL-safe-base64 encode them; supply this through a production secret manager.
BYOK_MASTER_KEY=
BYOK_MASTER_KEY_VERSION=local-v1
CONVERSATION_RECENT_MESSAGE_LIMIT=12
CONVERSATION_MESSAGE_MAX_CHARS=20000
CONVERSATION_SUMMARY_MAX_CHARS=8000
CONVERSATION_RETENTION_DAYS=30
CHAT_RETRIEVAL_TOP_K=6
CHAT_MIN_GROUNDED_SCORE=0.02
CHAT_MAX_OUTPUT_TOKENS=800
WIDGET_SESSION_AUDIENCE=support-agent-widget
WIDGET_SESSION_TTL_SECONDS=900
WIDGET_SESSION_RATE_LIMIT=20
WIDGET_SESSION_RATE_WINDOW_SECONDS=60
WIDGET_MESSAGE_RATE_LIMIT=30
WIDGET_MESSAGE_RATE_WINDOW_SECONDS=60

# Background ingestion worker
INGESTION_QUEUE_NAME=support-agent:ingestion
INGESTION_MAX_ATTEMPTS=5
INGESTION_RETRY_BASE_SECONDS=5
INGESTION_RETRY_MAX_SECONDS=300
INGESTION_JOB_TIMEOUT_SECONDS=900

# Browser-visible configuration (never put secrets in NEXT_PUBLIC_* or VITE_*)
API_INTERNAL_URL=http://127.0.0.1:8000
PLATFORM_ADMIN_EMAILS=admin@example.com
ADMIN_REPORTING_DATABASE_URL=
ADMIN_SESSION_MAX_AGE_SECONDS=900
DASHBOARD_PROXY_MAX_BODY_BYTES=25165824
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
VITE_API_BASE_URL=http://127.0.0.1:8000
