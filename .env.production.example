# Copy to .env.production, replace every CHANGE_ME value, and keep that file out of Git.
SUPPORT_AGENT_IMAGE_TAG=2026-08-07

POSTGRES_DB=support_agent
POSTGRES_USER=support_agent
POSTGRES_PASSWORD=CHANGE_ME_OWNER_PASSWORD
MIGRATION_DATABASE_URL=postgresql+asyncpg://support_agent:CHANGE_ME_OWNER_PASSWORD@postgres:5432/support_agent
APP_DATABASE_URL=postgresql+asyncpg://support_agent_app:CHANGE_ME_APP_PASSWORD@postgres:5432/support_agent
ADMIN_REPORTING_DATABASE_URL=postgresql+asyncpg://support_agent_reporting:CHANGE_ME_REPORTING_PASSWORD@postgres:5432/support_agent
PLATFORM_ADMIN_EMAILS=your-operator-email@example.com
PLATFORM_ADMIN_OTP_EMAIL=namikazeminato11318@gmail.com
ADMIN_SESSION_MAX_AGE_SECONDS=900

REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@redis:6379/0

AUTH_JWT_SECRET=CHANGE_ME_RANDOM_64_OR_MORE_CHARACTERS
AUTH_OTP_SECRET=CHANGE_ME_RANDOM_64_OR_MORE_CHARACTERS
# Must remain empty in production; non-empty values are rejected.
AUTH_OTP_TEST_CODE=
AUTH_OTP_TTL_SECONDS=90
AUTH_OTP_RESEND_COOLDOWN_SECONDS=60
AUTH_OTP_MAX_ATTEMPTS=5
AUTH_OTP_EMAIL_RATE_LIMIT=5
AUTH_OTP_EMAIL_RATE_WINDOW_SECONDS=3600
AUTH_OTP_IP_RATE_LIMIT=20
AUTH_OTP_IP_RATE_WINDOW_SECONDS=3600

# Development/staging email OTP sender. Use a Google App Password, never the normal
# Gmail account password. Replace SMTP with a transactional provider later.
AUTH_EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=relay-development@example.com
SMTP_PASSWORD=CHANGE_ME_GOOGLE_APP_PASSWORD
SMTP_FROM_EMAIL=relay-development@example.com
SMTP_FROM_NAME=Relay
SMTP_STARTTLS=true
SMTP_TIMEOUT_SECONDS=15
BYOK_MASTER_KEY=
BYOK_MASTER_KEY_VERSION=kms-v1

# Social sign-in (leave a provider blank to keep it disabled). Register the
# exact callback URL with each provider; secrets stay server-side only.
OAUTH_WEB_BASE_URL=https://app.example.com
OAUTH_ADMIN_WEB_BASE_URL=https://admin.example.com
OAUTH_STATE_TTL_SECONDS=600
OAUTH_HTTP_TIMEOUT_SECONDS=10
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_MICROSOFT_CLIENT_ID=
OAUTH_MICROSOFT_CLIENT_SECRET=
OAUTH_MICROSOFT_TENANT_ID=common
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=

AI_PROVIDER_MODE=deterministic
AI_PROVIDER_ID=deterministic
AI_BASE_URL=
AI_API_KEY=
LLM_MODEL_ID=deterministic-chat-v1
LLM_STRONG_MODEL_ID=
DETERMINISTIC_LLM_RESPONSE=Deterministic support response.
EMBEDDING_PROVIDER_ID=deterministic
EMBEDDING_MODEL_ID=deterministic-embedding-v1

PUBLIC_API_URL=https://api.example.com
PUBLIC_WIDGET_LOADER_URL=https://widget.example.com/loader.js
API_PUBLIC_PORT=8000
WEB_PUBLIC_PORT=3000
WIDGET_PUBLIC_PORT=8080
